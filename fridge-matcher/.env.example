# ============================================================
# LLM 配置模板（实验5）
# 使用方法：
#   1. 复制本文件为 .env：  copy .env.example .env
#   2. 在 .env 中填入真实值（.env 已被 .gitignore 忽略，不会提交）
#   3. 将 LLM_MODE 改为 api 后，callLLM() 将走真实 API 接入点
# ============================================================

# 运行模式：mock（占位，默认）| api（真实调用，需配置下面三项）
LLM_MODE=mock

# 模型服务地址（兼容 OpenAI 协议的 chat/completions 接口）
# 豆包（火山方舟）示例：
# LLM_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
LLM_API_URL=

# API Key（在模型服务商控制台创建；请勿将真实 Key 提交到任何版本库）
LLM_API_KEY=

# 模型标识：豆包用推理接入点 ID（如 ep-2024xxxxxxxx-xxxxx）或模型名
LLM_MODEL=
