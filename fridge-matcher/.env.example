# ============================================================
# LLM 配置模板（实验5）
# 使用方法：
#   1. 复制本文件为 .env：  copy .env.example .env
#   2. 在 .env 中填入真实值（.env 已被 .gitignore 忽略，不会提交）
#   3. 将 LLM_MODE 改为 api 后，callLLM() 将走真实 API 调用
# 注意：本模板文件会提交进版本库，严禁填入真实 API Key！
# ============================================================

# 运行模式：mock（占位，默认）| api（真实调用，需配置下面三项）
LLM_MODE=mock

# 模型服务地址：兼容 OpenAI 协议的 chat/completions 完整端点（注意必须带路径）
# 千问示例：https://maas.qianwenaiapi.com/compatible-mode/v1/chat/completions
# 豆包示例：https://ark.cn-beijing.volces.com/api/v3/chat/completions
LLM_API_URL=

# API Key（在模型服务商控制台创建；请勿将真实 Key 提交到任何版本库）
LLM_API_KEY=

# 模型标识：千问如 qwen3.8-flash / qwen-plus；豆包用推理接入点 ID（ep-开头）或模型名
LLM_MODEL=
